# Use legacy bundle on high-sierra
bottle="https://github.com/autobrew/bundler/releases/download/libsodium-1.0.22/libsodium-1.0.22-sonoma-universal.tar.xz"

# Skip if disabled
if [ "$DISABLE_AUTOBREW" ]; then return 0; fi
echo "Using autobrew bundle: $(basename $bottle)"

# Suppess linker warnings
if [ "m${MACOSX_DEPLOYMENT_TARGET:0:2}" = "m11" ] || [ "m${MACOSX_DEPLOYMENT_TARGET:0:2}" = "m14" ]; then
MMACOS="-mmacosx-version-min=14.8.5"
fi

# General setup
BREWDIR="$PWD/.deps"
mkdir -p $BREWDIR
curl -sSL $bottle -o libs.tar.xz
tar -xf libs.tar.xz --strip 1 -C $BREWDIR
rm -f libs.tar.xz

# Hardcoded flags
PKG_CFLAGS="-I$BREWDIR/include"
PKG_LIBS="-L$BREWDIR/lib -lsodium -pthread $MMACOS"

# Prevent CRAN builder from linking against old libs in /usr/local/lib
mv $BREWDIR/lib/libsodium.a $BREWDIR/sodium
PKG_LIBS=$(echo $PKG_LIBS | sed "s|-lsodium|../.deps/sodium|g")

# Cleanup
echo "rm -Rf .deps" >> cleanup
chmod +x cleanup
